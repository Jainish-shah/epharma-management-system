# Copy to .env and fill in before deploying:  cp .env.example .env
# NEVER commit the real .env — it is git-ignored.

# ---- required in production ----
DJANGO_DEBUG=0
# Generate: python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=
# Comma-separated hostnames that serve the app (no wildcards in production).
DJANGO_ALLOWED_HOSTS=epharma.example.com
# Secret that encrypts prescriptions, consultation messages and documents at rest.
# Generate a fresh one; if it is lost, existing encrypted records cannot be read.
EPHARMA_ENC_KEY=

# ---- database ----
# Leave DATABASE_URL unset to use SQLite (demo only). PostgreSQL is required in production.
DATABASE_URL=postgresql://epharma:CHANGE_ME@db:5432/epharma
POSTGRES_USER=epharma
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=epharma

# ---- TLS ----
# 0 when a load balancer / reverse proxy terminates TLS (the usual case; it forwards
# X-Forwarded-Proto). 1 to make the app itself redirect HTTP to HTTPS.
DJANGO_SSL_REDIRECT=0

# ---- payments (leave blank to keep the sandbox/mock gateway) ----
PAYMENT_PROVIDER=stripe
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ---- rate limiting (429) ----
# Requests allowed per window, per client IP. The auth tier covers login, registration and
# account deletion; everything else under /api/ uses the default tier. /api/health is never limited.
# Counters are per worker process, so the effective limit is (workers x the number below).
RATE_LIMIT_ENABLED=1
RATE_LIMIT_WINDOW=60
RATE_LIMIT=120
RATE_LIMIT_AUTH=10
# Set to 1 ONLY when a trusted proxy sets X-Forwarded-For. Otherwise the header is attacker
# controlled and anyone could forge a new identity per request to bypass the limit entirely.
DJANGO_TRUST_PROXY=0

# ---- server ----
# gunicorn worker processes per container. Each holds one database connection, so keep
# (workers x containers) below PostgreSQL's max_connections.
WEB_CONCURRENCY=3

# ---- compliance ----
# Set to the previous EPHARMA_ENC_KEY while rotating keys; remove once rotation has finished.
EPHARMA_ENC_KEY_OLD=
POLICY_VERSION=1.0
RETAIN_OTPS_DAYS=1
RETAIN_TOKENS_DAYS=30
RETAIN_NOTIFICATIONS_DAYS=180
RETAIN_AUDIT_DAYS=365
DJANGO_HSTS_SECONDS=31536000

# ---- optional infrastructure ----
# Event streaming through Kafka; unset uses the in-process bus.
KAFKA_BROKERS=
# Notification delivery channels: log, email, sms (comma-separated).
NOTIFY_CHANNELS=log
# Days after an order before a refill reminder is due.
REFILL_DAYS=30
# Host port the container publishes on.
WEB_PORT=8000
