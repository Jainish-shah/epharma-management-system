# Dependencies
node_modules/
.venv/
__pycache__/
*.pyc

# SQLite runtime database (regenerated + seeded on first run)
epharma.db
epharma.db-wal
epharma.db-shm
*.db
*.db-wal
*.db-shm

# OS / editor cruft
.DS_Store
*.log

# MS Word lock/owner temp files
~$*

# NOTE: public/ is the built React app (generated by `npm run build --prefix frontend`).
# It IS committed on purpose, so the app runs from a fresh clone with Python alone —
# no Node toolchain needed just to demo or deploy it. Rebuild it after changing frontend/src.
